# Copy to .env and set DMUE_ENV to local, staging, or production.
DMUE_ENV=local
DEFAULT_MODEL_ROUTE=dmue-full-v1

BASE_MONTHLY_AUTO_PREMIUM=120
MAX_PREMIUM_INCREASE_PCT=0.25
MAX_PREMIUM_DECREASE_PCT=0.20

CHROMA_PERSIST_DIR=./data/chroma_db
AUDIT_LOG_PATH=./data/audit/quotes.jsonl
UW_LOG_PATH=./data/uw/actions.jsonl
SUBMISSIONS_LOG_PATH=./data/uw/submissions.jsonl
UW_REFER_SCORE=80
UW_DECLINE_SCORE=95

RATE_LIMIT_PER_MINUTE=60
INGEST_QUEUE_MAX=100
CACHE_TTL_SECONDS=30
CIRCUIT_FAILURES=3
CIRCUIT_COOLDOWN_SECONDS=30

DMUE_API_URL=http://127.0.0.1:8000
# Live Sentinel Hub is off unless SENTINEL_LIVE_FETCH=true and credentials are set.
SENTINEL_LIVE_FETCH=false
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
# Alias for SENTINEL_CLIENT_SECRET when CLIENT_ID is set.
SENTINEL_API_TOKEN=

# Empty = open local API. Staging and production require a key (see DEPLOY.md).
DMUE_API_KEY=
AUTH_REQUIRED=false
# Comma-separated browser origins. Streamlit server-side calls do not need CORS.
CORS_ALLOW_ORIGINS=http://localhost:8501

# Local traces always write to TRACE_LOG_PATH (free, no account).
TRACE_LOG_PATH=./data/observability/traces.jsonl
# Optional LangSmith free-tier export. Leave off unless you have a key.
# https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dmue
